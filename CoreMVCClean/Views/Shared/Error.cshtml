@model Core.MVC.Clean.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@* Display the actual exception details if available *@
@if (!string.IsNullOrEmpty(Model.ExceptionMessage))
{
    <div class="alert alert-danger mt-4">
        <h4>Exception Details</h4>
        <p class="mb-2"><strong>Message:</strong> @Model.ExceptionMessage</p>

        @if (!string.IsNullOrEmpty(Model.ExceptionStackTrace))
        {
            <hr />
            <p class="mb-1"><strong>Stack Trace:</strong></p>
            <pre class="bg-dark text-light p-3 rounded" style="max-height: 300px; overflow-y: auto;"><code>@Model.ExceptionStackTrace</code></pre>
        }
    </div>
}