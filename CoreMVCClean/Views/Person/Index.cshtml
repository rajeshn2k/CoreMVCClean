@model IEnumerable<Core.Library.Clean.AdditionalService.PersonDTO>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-controller="Person" asp-action="Create" title="Create New Person" class="btn btn-success">
                    +
                </a>
                @Html.DisplayName("First Name")
            </th>
            <th>
                @Html.DisplayName("Last Name")
            </th>
            <th>@Html.DisplayName("Edit Person")</th>
            <th>@Html.DisplayName("Delete Person")</th>
        </tr>
        <tr>
            <th colspan="4">
                <form asp-controller="Person"
                      asp-action="Index"
                      method="get"
                      class="d-flex">

                    <input type="text"
                           name="search"
                           value="@Context.Request.Query["search"]"
                           class="form-control"
                           placeholder="Search Persons..."
                           style="max-width: 400px;" />

                    <button type="submit"
                            class="btn btn-primary ms-2">
                        Search
                    </button>

                    <a asp-controller="Person"
                       asp-action="Index"
                       class="btn btn-secondary ms-2">
                        Clear
                    </a>
                </form>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.firstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.lastName)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { personId = item.id })
                </td>
                <td>
                    @using (Html.BeginForm("Delete", "Person", new { personId = item.id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" onclick="return confirm('Are you sure you want to delete this person?');">
                            Delete
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
